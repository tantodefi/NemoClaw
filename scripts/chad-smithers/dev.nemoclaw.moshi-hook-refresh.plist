<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.nemoclaw.moshi-hook-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/r/.nemoclaw/source/scripts/chad-smithers/chad-moshi-hook-refresh.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- RunAtLoad + daily at 05:10 local: re-installs the Moshi claude hooks if they
       go stale after a moshi-hook auto-update, so Chad-session alerts never
       silently break again (idempotent no-op when already current). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>10</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/r/.nemoclaw/openwebui/moshi-hook-refresh.out.log</string>
  <key>StandardErrorPath</key><string>/Users/r/.nemoclaw/openwebui/moshi-hook-refresh.err.log</string>
</dict>
</plist>
