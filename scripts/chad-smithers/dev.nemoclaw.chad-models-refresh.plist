<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.nemoclaw.chad-models-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/r/.nemoclaw/source/scripts/chad-smithers/refresh-models.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Daily at 04:45 local — picks up newly launched NVIDIA open models so the
       fusion roster + experiments stay current with no manual edits. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>45</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/r/.nemoclaw/openwebui/chad-models-refresh.out.log</string>
  <key>StandardErrorPath</key><string>/Users/r/.nemoclaw/openwebui/chad-models-refresh.err.log</string>
</dict>
</plist>
