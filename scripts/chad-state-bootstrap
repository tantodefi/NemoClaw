#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# chad-state-bootstrap — One-shot installer for the chad-state side of
# the GitHub Actions spawn substrate.
#
# What it does:
#   1. Clone tantodefi/chad-state (or $CHAD_STATE_REPO) to a temp dir
#   2. Sync scripts/chad-state-templates/* into the working tree
#   3. Open a PR (or push direct to main with --no-pr) titled
#      "chore(chad-state): install agent-job workflow + spawn machinery"
#   4. Print the next-step commands the operator must run by hand
#      (gh secret set OPENAI_API_KEY ..., etc.) — secrets aren't
#      something this script will touch.
#
# This is host-side, not sandbox-side. Run from the operator's machine
# where you already have a gh auth token with repo write to chad-state.
#
# Usage:
#   chad-state-bootstrap                  # PR-based install (recommended)
#   chad-state-bootstrap --no-pr          # commit straight to main
#   chad-state-bootstrap --dry-run        # show what would change

set -euo pipefail

REPO="${CHAD_STATE_REPO:-tantodefi/chad-state}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATES_DIR="${SCRIPT_DIR}/chad-state-templates"

mode="pr"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-pr)   mode="direct"; shift ;;
    --dry-run) mode="dry"; shift ;;
    -h|--help)
      sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# //'; exit 0 ;;
    *) echo "chad-state-bootstrap: unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -d "$TEMPLATES_DIR" ] || { echo "templates dir missing: $TEMPLATES_DIR" >&2; exit 3; }
command -v gh >/dev/null 2>&1 || { echo "gh CLI not found" >&2; exit 3; }
gh auth status --hostname github.com >/dev/null 2>&1 || { echo "gh not authenticated" >&2; exit 3; }

work="$(mktemp -d -t "chad-state-bootstrap-XXXXXX")"
trap 'rm -rf "$work"' EXIT

echo "==> cloning $REPO -> $work"
gh repo clone "$REPO" "$work" -- --depth 5 --quiet

cd "$work"
default_branch="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
echo "==> default branch: $default_branch"
git checkout "$default_branch" --quiet

# Sync templates (preserve directory structure)
echo "==> syncing templates from $TEMPLATES_DIR"
new_count=0; updated_count=0; same_count=0
while IFS= read -r src; do
  rel="${src#$TEMPLATES_DIR/}"
  dest="$work/$rel"
  mkdir -p "$(dirname "$dest")"
  if [ ! -e "$dest" ]; then
    cp "$src" "$dest"
    new_count=$((new_count + 1))
    echo "  new: $rel"
  elif ! cmp -s "$src" "$dest"; then
    cp "$src" "$dest"
    updated_count=$((updated_count + 1))
    echo "  updated: $rel"
  else
    same_count=$((same_count + 1))
  fi
done < <(find "$TEMPLATES_DIR" -type f)

echo "==> ${new_count} new, ${updated_count} updated, ${same_count} unchanged"

if [ "$new_count" -eq 0 ] && [ "$updated_count" -eq 0 ]; then
  echo "==> nothing to install (chad-state already current)"
  exit 0
fi

if [ "$mode" = "dry" ]; then
  git status --short
  echo "==> dry-run: not committing or pushing"
  exit 0
fi

git add -A

# Use Chad's identity for the bootstrap commit
git config user.email "supachad@proton.me"
git config user.name "Chad Bootstrap"

commit_msg="chore(chad-state): install agent-job workflow + spawn machinery

Bootstrapped from nemoclaw/scripts/chad-state-templates/ via
chad-state-bootstrap. Powers the GitHub Actions sub-agent spawn
substrate (chad-spawn --substrate gha). See nemoclaw
docs/design/spawn-as-github-run.md for the architecture.

Files installed:
$(cd "$work" && git diff --cached --name-only | sed 's/^/  /')
"

if [ "$mode" = "direct" ]; then
  git commit -m "$commit_msg" --quiet
  git push origin "$default_branch"
  echo "==> committed + pushed to $default_branch"
else
  branch="bootstrap/agent-job-$(date -u +%Y%m%d)"
  git checkout -b "$branch" --quiet
  git commit -m "$commit_msg" --quiet
  git push -u origin "$branch" --quiet
  pr_url="$(gh pr create --repo "$REPO" --title "chore(chad-state): install agent-job workflow + spawn machinery" \
    --body "Installs the GHA sub-agent spawn substrate. Auto-generated by chad-state-bootstrap." \
    --head "$branch" --base "$default_branch")"
  echo "==> PR opened: $pr_url"
fi

cat <<'NEXT'

==> Next steps (run by hand on the operator host):

  # Set the API keys the runner needs (per-kind):
  gh secret set OPENAI_API_KEY     --repo tantodefi/chad-state --body "$YOUR_OPENAI_KEY"
  gh secret set ANTHROPIC_API_KEY  --repo tantodefi/chad-state --body "$YOUR_ANTHROPIC_KEY"

  # Verify the workflow exists:
  gh workflow list --repo tantodefi/chad-state | grep agent-job

  # Verify Chad's sandbox-side gh has push access to chad-state:
  ssh openshell-chad 'gh repo view tantodefi/chad-state'

  # Test a gha-substrate spawn from inside Chad's sandbox:
  ssh openshell-chad 'echo "Write a haiku about a sandbox" > /tmp/t.md && \
    chad-spawn --kind codex --task-file /tmp/t.md --substrate gha'

NEXT
