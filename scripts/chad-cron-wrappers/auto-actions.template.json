{
  "_meta": {
    "schema_version": 1,
    "description": "Chad's autonomous-action policy. Per-action-type rules with per-target overrides. Anything not listed falls through to _default; if _default is also missing, the action is BLOCKED.",
    "kill_switch_file": "/sandbox/.openclaw/workspace/.auto-disabled",
    "audit_log": "/sandbox/.openclaw-data/state/auto-action-log.jsonl",
    "counters_file": "/sandbox/.openclaw-data/state/auto-action-counters.json",
    "budget_reset": "utc-midnight",
    "modes": {
      "auto": "Chad performs the action immediately.",
      "draft": "Chad drafts the action and parks it for human review.",
      "block": "Chad must not perform the action."
    }
  },

  "_budgets": {
    "email_reply":              20,
    "email_send_new":            5,
    "email_forward":             5,
    "email_archive":           100,
    "email_trash":              50,
    "calendar_create":           5,
    "calendar_update":           5,
    "calendar_delete":           2,
    "calendar_invite_respond":  10,
    "github_comment":           10,
    "github_issue_open":         3,
    "github_issue_close":        3,
    "github_issue_label":       20,
    "github_pr_open":            1,
    "github_pr_review":          5,
    "github_pr_merge":           0,
    "github_repo_create":        0,
    "github_release":            0,
    "web_post_twitter":          0,
    "web_post_mastodon":         0,
