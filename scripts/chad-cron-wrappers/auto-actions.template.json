  "email_reply": {
    "_default": "block",
    "tjcooke@protonmail.com": "auto",
    "tjcooke@pm.me":          "auto",
    "tantodefi@proton.me":    "auto",
    "_comment_supachad":      "supachad@proton.me is Chad's own outbound address. Auto-replying to Chad's own emails would create a feedback loop (verified live 2026-05-03). Block self-replies.",
    "supachad@proton.me":     "block"
  },
  "email_send_new":            { "_default": "block" },
  "email_forward":             { "_default": "block" },
  "email_archive":             { "_default": "auto" },
  "email_trash":               { "_default": "block" },
  "email_mark_read":           { "_default": "auto" },

