    "subscription_subscribe":    0,
    "subscription_unsubscribe":  3,
    "external_upload":           0,
    "spawn_subagent":           24,
    "spawn_premium":             8,
    "gbrain_write":            100,
    "gbrain_delete":             5,
    "chad_self_modify_skill":    0,
    "chad_self_modify_cron":     0,
    "chad_self_modify_memory":   0,
    "chad_self_modify_identity": 0,
    "memory_curator_propose":    5,
