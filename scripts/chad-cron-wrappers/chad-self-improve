# chad-self-improve — Weekly self-improvement loop (Hermes pattern, v2).
#
# v1 collected a week of operational signal and spawned a multi-turn
# `researcher` sub-agent to write proposals. That failed in practice:
# the researcher hit LLM idle timeouts, never honored the JSON output
# contract, and agent-turn timeouts caused duplicate spawns (4 spawns
# in 5 minutes / 90k tokens burned on 2026-06-08). v2 keeps the signal
# collection but replaces the spawn with ONE single-turn, no-tools LLM
# call (the chad-drafter contract) plus:
#   • flock overlap lock        — no duplicate runs, ever
#   • daily dedupe              — at most one run section per UTC day
#   • --detach                  — re-exec under nohup so the cron agent
#                                 only acks the detach (cron-wrapper rule)
#   • machine-readable applies  — cron_edit/memory proposals flow into
#                                 the existing chad-proposal-apply →
#                                 chad-action-gate pipeline; everything
#                                 else stays prose for operator review
#
# Rules (unchanged from v1):
#   - DRAFT-ONLY for anything not covered by chad-proposal-apply's
#     gated kinds. This script never edits cron defs or config directly.
#   - Budget-aware: skips below minBudget without burning tokens.
#   - Idempotent: one section per day, prepended (freshest-first, same
#     convention as chad-budget-audit so proposal-apply's "first match
#     wins" regex always sees the newest block).
#
# Usage:
#   chad-self-improve [--days N] [--dry-run] [--budget-tokens N]
#                     [--timeout SECS] [--force] [--detach]
#
# Exit codes: 0 ran/skipped intentionally · 2 usage · 3 signal collection failed

import argparse
import datetime
import fcntl
import json
import os
import pathlib
import subprocess
import sys

UTC = getattr(datetime, "UTC", datetime.timezone.utc)

OPENCLAW_DATA = pathlib.Path(os.environ.get("CHAD_OPENCLAW_DATA", "/sandbox/.openclaw-data"))
WORKSPACE = pathlib.Path(os.environ.get("CHAD_WORKSPACE", "/sandbox/.openclaw/workspace"))
# Canonical proposals path — shared with chad-budget-audit and
# chad-proposal-apply. See v1 history: a split-brain once existed where
# self-improve wrote to a workspace path nobody read.
PROPOSALS_FILE = pathlib.Path(os.environ.get(
    "CHAD_PROPOSALS_FILE", str(OPENCLAW_DATA / "memory" / "feedback-proposals.md")))
QUEUE_FILE = OPENCLAW_DATA / "queue" / "tasks.jsonl"
SUBAGENTS_DIR = OPENCLAW_DATA / "subagents"
AUTO_ACTION_LOG = OPENCLAW_DATA / "state" / "auto-action-log.jsonl"
BUDGET_FILE = pathlib.Path(os.environ.get("CHAD_BUDGET_FILE", str(OPENCLAW_DATA / "budget.json")))
LOCK_FILE = "/tmp/chad-self-improve.lock"

# Prompt budget: Nemotron via `openclaw agent --local` degrades into
# "Agent couldn't generate a response" on oversized single-turn prompts.
# Keep the whole prompt comfortably under this many characters.
MAX_PROMPT_CHARS = 7000


def now():
    return datetime.datetime.now(UTC)


def iso(dt=None):
    return (dt or now()).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(s):
    try:
        return datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None


def run_env(cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, HOME="/sandbox"))
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"
    except OSError as exc:
        return 127, "", str(exc)


def find_json(s):
    """First balanced {...} span (chad-drafter algorithm)."""
    start = s.find("{")
    while start != -1:
        depth, in_str, esc = 0, False, False
        for i in range(start, len(s)):
            c = s[i]
            if esc:
                esc = False
                continue
            if c == "\\":
                esc = True
                continue
            if c == '"':
                in_str = not in_str
                continue
            if in_str:
                continue
            if c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    return s[start:i + 1]
        start = s.find("{", start + 1)
    return None


# ─────────────────────────────────────────────────────────────────
# Signal collection (kept from v1, with per-section size caps)
# ─────────────────────────────────────────────────────────────────

def collect_signal(days):
    cutoff = now() - datetime.timedelta(days=days)
    sig = {}

    # 1. Failed spawns
    failed = []
    if QUEUE_FILE.is_file():
        for raw in QUEUE_FILE.read_text().splitlines():
            raw = raw.strip()
            if not raw:
                continue
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                continue
            ts = parse_ts(rec.get("ts_utc", ""))
            if ts and ts >= cutoff and rec.get("status") == "failed":
                failed.append({k: rec.get(k) for k in
                               ("task_id", "kind", "status", "note", "ts_utc")})
    sig["failed_spawns"] = failed[:8]
    sig["failed_spawns_total"] = len(failed)

    # 2. Recent sub-agent results
    results = []
    if SUBAGENTS_DIR.is_dir():
        dirs = sorted((p for p in SUBAGENTS_DIR.iterdir() if p.is_dir()),
                      key=lambda p: p.stat().st_mtime, reverse=True)[:15]
        for d in dirs:
            r = d / "result.json"
            if r.is_file():
                try:
                    parsed = json.loads(r.read_text())
                except (OSError, json.JSONDecodeError):
                    continue
                if parsed.get("status") in ("failed", "done"):
                    results.append({"id": d.name, "kind": parsed.get("kind"),
                                    "status": parsed.get("status"),
                                    "summary": str(parsed.get("summary", ""))[:160]})
    sig["recent_subagents"] = results

    # 3. Cron run failures — read the run logs directly instead of N×
    # `openclaw cron runs` subprocesses (v1 burned up to 20s per cron and
    # needed a live gateway; the JSONL files are the source of truth).
    # Map job UUIDs (the runs/*.jsonl filenames) to human cron names so the
    # LLM can emit cron_edit proposals against names, not UUIDs.
    cron_names = {}
    try:
        jobs = json.load(open("/sandbox/.openclaw/cron/jobs.json"))
        for j in jobs.get("jobs", []):
            if j.get("id") and j.get("name"):
                cron_names[j["id"]] = j["name"]
    except (OSError, json.JSONDecodeError):
        pass

    cron_failures = []
    runs_dir = pathlib.Path("/sandbox/.openclaw/cron/runs")
    if runs_dir.is_dir():
        for f in sorted(runs_dir.glob("*.jsonl")):
            bad = []
            try:
                lines = f.read_text().splitlines()[-200:]
            except OSError:
                continue
            for raw in lines:
                try:
                    r = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                if r.get("action") != "finished":
                    continue
                ts = (datetime.datetime.fromtimestamp(r["ts"] / 1000, tz=UTC)
                      if r.get("ts") else None)
                if ts is None or ts < cutoff:
                    continue
                if (r.get("status") or "") not in ("ok", "completed", "success"):
                    bad.append({"status": r.get("status"),
                                "error": str(r.get("error") or "")[:140],
                                "ts": iso(ts)})
            if bad:
                cron_failures.append({"cron": cron_names.get(f.stem, f.stem),
                                      "fail_count": len(bad),
                                      "samples": bad[-2:]})
    sig["cron_failures"] = cron_failures[:10]

    # 4. Auto-action errors
    auto_failures = []
    if AUTO_ACTION_LOG.is_file():
        for raw in AUTO_ACTION_LOG.read_text().splitlines()[-500:]:
            raw = raw.strip()
            if not raw:
                continue
            try:
                entry = json.loads(raw)
            except json.JSONDecodeError:
                continue
            ts = parse_ts(entry.get("ts", ""))
            if ts and ts >= cutoff and entry.get("result") not in ("ok", None):
                auto_failures.append({"action": entry.get("action"),
                                      "target": entry.get("target"),
                                      "result": str(entry.get("result"))[:120]})
    sig["auto_action_errors"] = auto_failures[:10]

    # 5. Existing feedback memories (titles + first line only — the
    # full 800-char heads from v1 blew the prompt budget)
    feedback = []
    mem_dir = WORKSPACE / "memory"
    if mem_dir.is_dir():
        for p in sorted(mem_dir.glob("feedback_*.md")):
            try:
                head = p.read_text()[:200].replace("\n", " ")
            except OSError:
                continue
            feedback.append(f"{p.name}: {head}")
    sig["existing_feedback"] = feedback[:10]

    # 6. Outstanding proposals sample (latest 1500 chars)
    outstanding = ""
    if PROPOSALS_FILE.is_file():
        try:
            outstanding = PROPOSALS_FILE.read_text()[:1500]
        except OSError:
            pass
    sig["outstanding_proposals_sample"] = outstanding
    return sig


# ─────────────────────────────────────────────────────────────────
# Single-turn proposal pass
# ─────────────────────────────────────────────────────────────────

RULES = (
    "STRICT RULES:\n"
    "  • Output exactly ONE valid JSON object on a SINGLE line. No prose. No code fences.\n"
    "  • Do NOT call any tools. Do NOT request more information.\n"
    "  • Propose 0-3 durable improvements. Fewer is better. If the signal is "
    "too thin, return {\"proposals\":[],\"summary\":\"signal too thin\"}.\n"
    "  • Every proposal MUST cite which signal section supports it.\n"
    "  • Do NOT propose code or policy changes (those go through the PR loop).\n"
    "  • kind=cron_edit only for timeoutSeconds/maxOutputTokens with integer "
    "old/new values taken from the signal. Qualitative cron changes "
    "(schedule, message) must use kind=prose.\n"
    "  • kind=memory content is ONE short imperative rule (≤200 chars) that "
    "would have prevented an observed failure.\n"
)

SCHEMA = (
    'Schema: {"proposals":[{"kind":"prose|memory|cron_edit",'
    '"title":"<short>","body":"<markdown, ≤120 words>",'
    '"reason":"<which signal supports this>",'
    '"cron":"<name, cron_edit only>","field":"timeoutSeconds|maxOutputTokens",'
    '"old":123,"new":456,'
    '"content":"<memory kind only>"}],"summary":"<one line>"}'
)


def build_prompt(sig, days):
    body = json.dumps(sig, ensure_ascii=False)
    # Trim the biggest free-text field first if over budget.
    overhead = 1600  # rules + schema + framing
    if len(body) + overhead > MAX_PROMPT_CHARS:
        sig = dict(sig, outstanding_proposals_sample=sig["outstanding_proposals_sample"][:400])
        body = json.dumps(sig, ensure_ascii=False)
    if len(body) + overhead > MAX_PROMPT_CHARS:
        body = body[:MAX_PROMPT_CHARS - overhead]
    return (
        "You are Chad's self-improvement analyst. Below is the last "
        f"{days} days of operational signal: failed sub-agent spawns, cron "
        "run failures, auto-action errors, the existing feedback-rule "
        "corpus, and proposals still awaiting action. Propose durable "
        "improvements to Chad's own behavior.\n\n" + RULES + "\n" + SCHEMA +
        "\n\nSignal (JSON):\n" + body +
        "\n\nReturn ONLY the JSON object."
    )


def llm(prompt, timeout):
    rc, out, err = run_env(
        ["timeout", "--kill-after=5", f"{timeout}s",
         "openclaw", "agent", "--agent", "main", "--local",
         "--session-id", f"self-improve-{int(now().timestamp())}",
         "-m", prompt],
        timeout=timeout + 15)
    if rc != 0 and not out.strip():
        return None, f"agent exit {rc}: {err.strip()[:200]}"
    raw = find_json(out)
    if not raw:
        return None, f"no JSON in response: {out.strip()[:200]}"
    try:
        return json.loads(raw), None
    except json.JSONDecodeError as exc:
        return None, f"json decode: {exc}"


def validate(parsed):
    """Split LLM proposals into (prose_list, applies_list)."""
    prose, applies = [], []
    for p in (parsed.get("proposals") or [])[:3]:
        if not isinstance(p, dict):
            continue
        kind = str(p.get("kind", "prose")).strip()
        title = str(p.get("title", "")).strip()[:120]
        body = str(p.get("body", "")).strip()[:1200]
        reason = str(p.get("reason", "")).strip()[:300]
        if not title or not body:
            continue
        entry = {"kind": kind, "title": title, "body": body, "reason": reason}
        if kind == "cron_edit":
            cron = str(p.get("cron", "")).strip()
            field = str(p.get("field", "")).strip()
            old, new = p.get("old"), p.get("new")
            if (cron and field in ("timeoutSeconds", "maxOutputTokens")
                    and isinstance(old, int) and isinstance(new, int)
                    and old > 0 and new > 0):
                applies.append({"kind": "cron_edit", "cron": cron, "field": field,
                                "old": old, "new": new, "reason": reason or title})
            else:
                entry["kind"] = "prose"  # malformed cron_edit degrades to prose
        elif kind == "memory":
            content = str(p.get("content", "")).strip()[:200]
            if content:
                applies.append({"kind": "memory", "name": title,
                                "content": content, "reason": reason or title})
            else:
                entry["kind"] = "prose"
        prose.append(entry)
    return prose, applies


def render_section(ts, days, sig, prose, applies, summary, llm_err):
    lines = [f"## Self-improvement run — {ts}",
             f"- window: {days}d · failed_spawns={sig['failed_spawns_total']} "
             f"cron_failures={sum(c.get('fail_count', 0) for c in sig['cron_failures'])} "
             f"auto_errors={len(sig['auto_action_errors'])}"]
    if llm_err:
        lines += ["", f"_LLM pass failed: {llm_err} — signal collected, no proposals this run._"]
    elif not prose:
        lines += ["", f"_No proposals: {summary or 'signal too thin'}_"]
    else:
        for p in prose:
            lines += ["", f"### {p['title']} ({p['kind']})", "", p["body"]]
            if p["reason"]:
                lines += ["", f"_Evidence: {p['reason']}_"]
        if applies:
            lines += ["", "### Proposals (machine-readable)", "", "```json",
                      json.dumps({"ts": ts, "source": "chad-self-improve",
                                  "applies": applies}, indent=2),
                      "```"]
        if summary:
            lines += ["", f"_Summary: {summary}_"]
    return "\n".join(lines) + "\n"


def prepend(path, section):
    old = path.read_text() if path.is_file() else ""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(section + ("\n" + old if old.strip() else ""))


# ─────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(prog="chad-self-improve")
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--budget-tokens", type=int, default=15000,
                    help="LLM reserve check: skip if remaining < 2x this")
    ap.add_argument("--timeout", type=int, default=120,
                    help="Single-turn LLM timeout (default 120s)")
    ap.add_argument("--force", action="store_true",
                    help="Run even if a section for today already exists")
    ap.add_argument("--detach", action="store_true",
                    help="Re-exec under nohup and return immediately (cron mode)")
    args = ap.parse_args()

    if args.detach:
        argv = [a for a in sys.argv[1:] if a != "--detach"]
        log = f"/tmp/chad-self-improve-{now().strftime('%Y%m%dT%H%M%SZ')}.log"
        with open(log, "ab") as out:
            subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), *argv],
                stdout=out, stderr=out, stdin=subprocess.DEVNULL,
                start_new_session=True)
        print(f"chad-self-improve detached (log: {log})")
        return 0

    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("skipped: another chad-self-improve run holds the lock")
        return 0

    today = now().strftime("%Y-%m-%d")
    if not args.force and PROPOSALS_FILE.is_file():
        if f"## Self-improvement run — {today}" in PROPOSALS_FILE.read_text():
            print(f"skipped: already ran today ({today}); use --force to rerun")
            return 0

    # Budget gate — direct budget.json read (chad-budget has a stale
    # env-var export bug; see chad-mail-check).
    remaining = 0
    try:
        remaining = int(json.load(BUDGET_FILE.open()).get("remaining_tokens", 0))
    except (OSError, json.JSONDecodeError, ValueError, TypeError):
        pass
    needed = args.budget_tokens * 2
    if not args.dry_run and remaining < needed:
        prepend(PROPOSALS_FILE,
                f"## Self-improvement run — {iso()}\n"
                f"_(skipped: remaining={remaining} < {needed})_\n")
        print(f"skipped: budget {remaining} < {needed}")
        return 0

    try:
        sig = collect_signal(args.days)
    except Exception as exc:  # signal collection must fail loud
        print(f"chad-self-improve: signal collection failed: {exc}", file=sys.stderr)
        return 3

    prompt = build_prompt(sig, args.days)
    if args.dry_run:
        print(f"[dry-run] prompt chars={len(prompt)} "
              f"failed_spawns={sig['failed_spawns_total']} "
              f"cron_failures={len(sig['cron_failures'])} "
              f"auto_errors={len(sig['auto_action_errors'])}")
        print(prompt)
        return 0

    parsed, llm_err = llm(prompt, args.timeout)
    prose, applies, summary = [], [], ""
    if parsed:
        prose, applies = validate(parsed)
        summary = str(parsed.get("summary", ""))[:200]

    ts = iso()
    section = render_section(ts, args.days, sig, prose, applies, summary, llm_err)
    prepend(PROPOSALS_FILE, section)
    print(f"chad-self-improve: proposals={len(prose)} machine_applies={len(applies)} "
          f"llm={'ok' if parsed else 'failed'} -> {PROPOSALS_FILE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
