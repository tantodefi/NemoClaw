#
# chad-proposal-apply — Close the autonomy loop by applying safe-list
# proposals from feedback-proposals.md.
#
# Reads the LATEST `### Proposals (machine-readable)` JSON block emitted
# by chad-budget-audit (most recent first). Each entry has an optional
# `kind`; if absent, it's treated as a cron-edit (backward-compatible
# with v1 proposals that omit the field).
#
# Supported kinds:
#   • cron_edit (default) — patch timeoutSeconds/maxOutputTokens via
#     `openclaw cron edit`. Guarded by:
#       (a) cron exists; (b) field in safe-list; (c) new value within
#       absolute sanity cap (timeoutSeconds ≤ 7200, maxOutputTokens
#       ≤ 32768) and at least 1.1× difference; (d) chad-action-gate
#       chad_self_modify_cron returns "auto" — otherwise the entry is
#       routed to ### Pending operator review for one-click apply.
#   • memory      — append a memory line via chad-action-gate
#                   chad_self_modify_memory (default policy: auto).
#   • automation, note, calendar_event — recognised but parked under
#     ### Pending operator review until handlers ship (v3 scope).
#
# The applier never edits code, never changes schedules, never
# registers new crons, never modifies policy directly. Riskier classes
# of change always round-trip through operator review per the autonomy
# roadmap.
#
# Aging: ### Applied blocks older than 30 days are pruned at the start
# of each run so the proposals file doesn't grow unbounded.
#
# Output: appends `## Applied — <ts>` block to feedback-proposals.md
# listing what was applied and what was skipped, plus an entry per apply
# in the chad-action-gate audit log.
#
# Idempotency: every applied entry is matched against the audit log
# (last 24h) by (cron, field, new) tuple. Duplicate entries from a
# re-run of the same proposals block are no-ops.
#
# Registered as a daily cron by chad-setup.sh (04:30 UTC, after Mon
# budget audit and ahead of the 06:00 email-check window).
#
# Usage:
#   chad-proposal-apply               # apply latest proposals block
#   chad-proposal-apply --dry-run     # parse + validate only
#   chad-proposal-apply --max-apply N # cap applies per run (default 5)

set -uo pipefail

# shellcheck source=/dev/null
. /usr/local/share/chad/_chad-paths.sh 2>/dev/null || true

PROPOSALS_FILE="${CHAD_PROPOSALS_FILE:-/sandbox/.openclaw-data/memory/feedback-proposals.md}"
AUDIT_LOG="${CHAD_AUTO_ACTION_LOG:-/sandbox/.openclaw-data/state/auto-action-log.jsonl}"
PROFILES_FILE="${CHAD_PROFILES_FILE:-/usr/local/share/chad/task-profiles.json}"

dry_run=0
max_apply=5

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    --max-apply) max_apply="$2"; shift 2 ;;
    -h|--help)
      sed -n '4,35p' "$0" | sed 's/^# \{0,1\}//' >&2
      exit 0 ;;
    *) echo "chad-proposal-apply: unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ ! -r "$PROPOSALS_FILE" ]; then
  echo "chad-proposal-apply: no proposals file at ${PROPOSALS_FILE} — nothing to apply"
  exit 0
fi

PROPOSALS_FILE="$PROPOSALS_FILE" \
AUDIT_LOG="$AUDIT_LOG" \
DRY_RUN="$dry_run" \
MAX_APPLY="$max_apply" \
python3 <<'PY'
import json, os, re, subprocess, datetime, sys

proposals_file = os.environ["PROPOSALS_FILE"]
audit_log = os.environ["AUDIT_LOG"]
dry_run = os.environ["DRY_RUN"] == "1"
max_apply = int(os.environ["MAX_APPLY"])

# ── Find the latest ```json block under "### Proposals (machine-readable)" ──
text = open(proposals_file).read()
# Match the most recent block. The audit prepends new content, so the
# first match in the file is the freshest.
m = re.search(r"### Proposals \(machine-readable\)\s*\n+```json\s*\n(.+?)\n```",
              text, re.DOTALL)
if not m:
    print("chad-proposal-apply: no Proposals block found — nothing to apply")
    raise SystemExit(0)

try:
    proposals = json.loads(m.group(1))
except json.JSONDecodeError as exc:
    print(f"chad-proposal-apply: malformed Proposals JSON: {exc}")
    raise SystemExit(2)

applies = proposals.get("applies") or []
proposal_ts = proposals.get("ts", "?")
if not applies:
    print(f"chad-proposal-apply: 0 applies in latest block (ts={proposal_ts})")
    raise SystemExit(0)

# ── Index audit log: skip duplicates within last 24h ──
seen = set()
cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=24)
if os.path.exists(audit_log):
    for raw in open(audit_log):
        raw = raw.strip()
        if not raw: continue
        try:
            entry = json.loads(raw)
        except Exception:
            continue
        if entry.get("action") != "chad_self_modify_cron": continue
        if entry.get("result") != "ok": continue
        try:
            ts = datetime.datetime.fromisoformat(entry["ts"].replace("Z", "+00:00"))
        except Exception:
            continue
        if ts < cutoff: continue
        # detail format: "field=<f>,old=<o>,new=<n>"
        detail = entry.get("detail", "")
        seen.add((entry.get("target"), detail))

# ── Resolve cron IDs ──
try:
    raw = subprocess.check_output(
        ["openclaw", "cron", "list", "--json"],
        stderr=subprocess.DEVNULL, text=True, timeout=15,
    )
    crons_raw = json.loads(raw)
    cron_index = {}
    if isinstance(crons_raw, list):
        items = crons_raw
    else:
        items = crons_raw.get("jobs") or crons_raw.get("items") or []
    for c in items:
        if c.get("name") and c.get("id"):
            cron_index[c["name"]] = c["id"]
except Exception as exc:
    print(f"chad-proposal-apply: could not list crons: {exc}")
    raise SystemExit(3)

SAFE_FIELDS = {"timeoutSeconds", "maxOutputTokens"}
# Absolute sanity caps for cron-edit proposals. Anything beyond gets
# routed to operator review instead of silently rejected. These caps
# are intentionally permissive — the goal is to block runaway/typo
# proposals (e.g. timeoutSeconds=999999), not evidence-based ones
# (chad-budget-audit's 1.5× p95 recommendations).
FIELD_CAPS = {
    "timeoutSeconds": 7200,    # 2 hours — longer than any sane cron
    "maxOutputTokens": 32768,  # upstream max for our models
}
MIN_CHANGE_RATIO = 1.1  # don't bother applying changes < 10%

applied = []
skipped = []
pending = []  # routed to operator review (gate=draft, or kind not yet auto)
applies_left = max_apply

def park_for_review(name, field, old, new, reason, why):
    """Route an entry to ### Pending operator review."""
    pending.append((name, field, old, new, reason, why))

for p in applies:
    kind = p.get("kind") or "cron_edit"
    name = p.get("cron") or p.get("target") or p.get("name")
    field = p.get("field")
    old = p.get("old")
    new = p.get("new")
    reason = p.get("reason", "")
    detail = f"kind={kind},field={field},old={old},new={new}"

    if applies_left <= 0:
        skipped.append((name, field, old, new, "max-apply cap reached"))
        continue

    # ── kind: memory — chad_self_modify_memory defaults to "auto" ──
    if kind == "memory":
        content = p.get("content") or p.get("value")
        if not content:
            skipped.append((name or "memory", field or "-", old, new, "missing content"))
            continue
        try:
            gate = subprocess.run(
                ["chad-action-gate", "check", "chad_self_modify_memory",
                 name or "memory"],
                capture_output=True, text=True, timeout=10,
            )
            decision = gate.stdout.strip()
        except Exception as exc:
            skipped.append((name or "memory", "memory", old, new,
                            f"gate check failed: {exc}"))
            continue
        if decision != "auto":
            park_for_review(name or "memory", "memory", "-", "-", reason,
                            f"gate returned {decision!r}")
            continue
        if dry_run:
            applied.append((name or "memory", "memory", "-",
                            content[:60], reason, "[dry-run]"))
            applies_left -= 1
            continue
        # Append to today's memory file under ## Self-modify
        memfile = subprocess.run(
            ["chad-ensure-today-memory"],
            capture_output=True, text=True, timeout=10,
        ).stdout.strip()
        if memfile and os.path.isfile(memfile):
            with open(memfile, "a") as fh:
                fh.write(f"\n### Self-modify (memory) — {datetime.datetime.now(datetime.timezone.utc).isoformat()}\n{content}\n")
            applied.append((name or "memory", "memory", "-",
                            content[:60], reason, "applied"))
            applies_left -= 1
        else:
            skipped.append((name or "memory", "memory", old, new,
                            "could not resolve today memory file"))
        continue

    # ── kinds parked for v3: automation, note, calendar_event ──
    if kind in ("automation", "note", "calendar_event"):
        park_for_review(name or kind, kind, old, new, reason,
                        f"kind={kind} handler not yet implemented (v3)")
        continue

    # ── kind: cron_edit (default) ──
    if not name or not field:
        skipped.append((name or "?", field or "?", old, new, "missing cron/field"))
        continue
    if field not in SAFE_FIELDS:
        skipped.append((name, field, old, new, f"field not in safe-list ({sorted(SAFE_FIELDS)})"))
        continue
    if name not in cron_index:
        skipped.append((name, field, old, new, "cron not found in cron list"))
        continue
    if not isinstance(old, int) or not isinstance(new, int) or old <= 0 or new <= 0:
        skipped.append((name, field, old, new, "non-positive int values"))
        continue
    # Absolute cap: anything beyond gets routed to operator review,
    # not silently rejected. Replaces the old ±2× bound that was
    # blocking evidence-based proposals (where new=p95×1.5 can be
    # 30-100× old when old was set conservatively).
    if new > FIELD_CAPS[field]:
        park_for_review(name, field, old, new, reason,
                        f"new={new} > sanity cap {FIELD_CAPS[field]} — operator review")
        continue
    # Trivial-change suppression
    ratio = max(new, old) / max(min(new, old), 1)
    if ratio < MIN_CHANGE_RATIO:
        skipped.append((name, field, old, new,
                        f"change < {MIN_CHANGE_RATIO}× — not worth applying"))
        continue
    # Idempotency: skip if we already applied this exact change today.
    if (name, detail) in seen:
        skipped.append((name, field, old, new, "already applied within 24h"))
        continue

    # Gate via chad-action-gate.
    try:
        gate = subprocess.run(
            ["chad-action-gate", "check", "chad_self_modify_cron", name],
            capture_output=True, text=True, timeout=10,
        )
        decision = gate.stdout.strip()
    except Exception as exc:
        skipped.append((name, field, old, new, f"gate check failed: {exc}"))
        continue
    if decision != "auto":
        # Don't silently skip — surface for operator review. This is
        # the dominant outcome under the current "draft" default for
        # chad_self_modify_cron, so failing loud here closes the loop.
        park_for_review(name, field, old, new, reason,
                        f"gate returned {decision!r} — operator review")
        continue

    if dry_run:
        applied.append((name, field, old, new, reason, "[dry-run]"))
        applies_left -= 1
        continue

    # Apply via openclaw cron edit. Map field → CLI flag.
    cid = cron_index[name]
    flag = {
        "timeoutSeconds": "--timeout-seconds",
        "maxOutputTokens": "--max-tokens",
    }[field]
    try:
        edit = subprocess.run(
            ["openclaw", "cron", "edit", cid, flag, str(new)],
            capture_output=True, text=True, timeout=15,
        )
        if edit.returncode != 0:
            skipped.append((name, field, old, new,
                            f"cron edit exit {edit.returncode}: {edit.stderr.strip()[:120]}"))
            continue
    except Exception as exc:
        skipped.append((name, field, old, new, f"cron edit raised: {exc}"))
        continue

    # Log via chad-action-gate.
    try:
        subprocess.run(
            ["chad-action-gate", "log", "chad_self_modify_cron", name,
             "--result", "ok", "--detail", detail],
            capture_output=True, text=True, timeout=5,
        )
    except Exception:
        pass

    applied.append((name, field, old, new, reason, "applied"))
    applies_left -= 1

# ── Prune ### Applied blocks older than 30 days ──
# Keeps the proposals file from growing unbounded. Operates by reading
# the whole file, removing matched ranges, writing back. Only runs in
# non-dry-run mode so smoke tests don't mutate the file.
if not dry_run:
    try:
        full = open(proposals_file).read()
        prune_cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=30)
        # Each block: "## Applied — <ts>\n…(until next ## or end)"
        # or "## Pending operator review — <ts>\n…"
        pruned_count = 0
        def _strip_old(match):
            global pruned_count
            ts_str = match.group(1)
            try:
                btime = datetime.datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
            except Exception:
                return match.group(0)
            if btime < prune_cutoff:
                pruned_count += 1
                return ""
            return match.group(0)
        full_new = re.sub(
            r"\n## (?:Applied|Pending operator review) — (\S+).*?(?=\n## |\Z)",
            _strip_old, full, flags=re.DOTALL,
        )
        if pruned_count:
            open(proposals_file, "w").write(full_new)
    except Exception:
        pass  # pruning is best-effort

# ── Dedupe pending entries against blocks already in the file ──
# The applier runs daily but proposal blocks refresh weekly: without
# this, the same parked proposal lands in a fresh "## Pending operator
# review" block every day for a week. Match on the rendered table-row
# prefix — identical (target, field, old, new) means already surfaced.
if pending:
    try:
        _existing = open(proposals_file).read()
    except OSError:
        _existing = ""
    pending = [p for p in pending
               if f"| {p[0]} | {p[1]} | {p[2]} | {p[3]} |" not in _existing]

# ── Append "## Applied — <ts>" block to proposals file ──
# Skip entirely when the run was a no-op (nothing applied, skipped, or
# newly pending) — daily "(nothing applied)" blocks just grow the file.
if not (applied or skipped or pending):
    print(f"chad-proposal-apply: applied=0 skipped=0 pending=0 "
          f"(no-op, dry_run={dry_run}, max_apply={max_apply})")
    sys.exit(0)

ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
out = ["", f"## Applied — {ts}", ""]
out.append(f"_From proposals block ts={proposal_ts}; max_apply={max_apply}; dry_run={dry_run}._")
out.append("")
out.append("### Applied")
if applied:
    out.append("| cron | field | old | new | reason | status |")
    out.append("|------|-------|----:|----:|--------|--------|")
    for n, f, o, w, r, s in applied:
        out.append(f"| {n} | {f} | {o} | {w} | {r} | {s} |")
else:
    out.append("- (nothing applied)")
out.append("")
out.append("### Skipped")
if skipped:
    out.append("| cron | field | old | new | reason |")
    out.append("|------|-------|----:|----:|--------|")
    for n, f, o, w, r in skipped:
        out.append(f"| {n} | {f} | {o} | {w} | {r} |")
else:
    out.append("- (nothing skipped)")
out.append("")
if pending:
    # Separate "## Pending operator review" block so the operator can
    # spot it without scanning past the routine applied/skipped tables.
    out.append("")
    out.append(f"## Pending operator review — {ts}")
    out.append("")
    out.append("_These proposals are evidence-based but were not auto-applied "
               "(gate=draft, sanity cap, or v3-scope kind). Apply manually or "
               "flip the action-gate policy if you trust them._")
    out.append("")
    out.append("| target | field | old | new | reason | why parked |")
    out.append("|--------|-------|----:|----:|--------|-----------|")
    for n, f, o, w, r, w2 in pending:
        out.append(f"| {n} | {f} | {o} | {w} | {r} | {w2} |")
    out.append("")

# Append in-place. Don't prepend — the applier is downstream of the
# proposals log; ordering within the file is "newest header at top,
# applied blocks follow each proposal".
with open(proposals_file, "a") as f:
    f.write("\n".join(out) + "\n")

print(f"chad-proposal-apply: applied={len(applied)} skipped={len(skipped)} "
      f"pending={len(pending)} (dry_run={dry_run}, max_apply={max_apply})")
PY
