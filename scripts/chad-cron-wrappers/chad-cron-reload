#
# chad-cron-reload — Reconcile the gateway's in-memory cron list with cron/jobs.json.
#
# Why this exists:
#   The OpenClaw gateway loads cron jobs into memory at startup. If jobs.json
#   was restored from chad-state AFTER the gateway came up (the cold-boot path
#   in chad-restore-from-github.sh), the gateway is running with an empty list
#   even though disk has six entries. There is no `openclaw cron reload`
#   command — this helper diffs jobs.json against `openclaw cron list --json`
#   and calls `openclaw cron add` for each missing entry.
#
# Usage:
#   chad-cron-reload [--dry-run]
#
# Idempotent: jobs already registered (matched by name) are skipped.
# Returns 0 if all missing entries were re-registered (or none were missing),
# non-zero if any add failed.

set -uo pipefail

JOBS_FILE="${CHAD_CRON_JOBS:-/sandbox/.openclaw-data/cron/jobs.json}"
GATEWAY_URL="${OPENCLAW_GATEWAY_URL:-ws://127.0.0.1:18790}"

DRY_RUN=0
if [ "${1:-}" = "--dry-run" ]; then
  DRY_RUN=1
fi

if [ ! -r "$JOBS_FILE" ]; then
  echo "[cron-reload] no jobs.json at ${JOBS_FILE} — nothing to reload"
  exit 0
fi

if ! command -v openclaw >/dev/null 2>&1; then
  echo "[cron-reload] openclaw CLI not found" >&2
  exit 1
fi

# Names of jobs already registered with the gateway (in-memory).
existing_names="$(OPENCLAW_GATEWAY_URL="$GATEWAY_URL" \
  openclaw cron list --all --json 2>/dev/null \
  | python3 -c 'import json,sys
try:
    data = json.load(sys.stdin)
    if isinstance(data, list):
        jobs = data
    else:
        jobs = data.get("jobs", []) or data.get("items", [])
    for j in jobs:
        n = j.get("name")
        if n: print(n)
except Exception:
    pass' 2>/dev/null || true)"

# For each enabled job in jobs.json, emit the openclaw cron add invocation
# unless its name already appears in the gateway's list.
to_register="$(python3 - "$JOBS_FILE" <<'PY'
import json, sys
path = sys.argv[1]
try:
    data = json.load(open(path))
except Exception as e:
    sys.stderr.write(f"jobs.json parse error: {e}\n")
    sys.exit(0)
for j in data.get("jobs", []):
    if not j.get("enabled", True):
        continue
    name = j.get("name") or ""
    sched = j.get("schedule", {}) or {}
    expr = sched.get("expr", "")
    payload = j.get("payload", {}) or {}
    msg = payload.get("message", "") or ""
    target = j.get("sessionTarget", "isolated")
    if not (name and expr and msg):
        continue
    # JSON-encode each field so we can pass them safely through bash.
    print(json.dumps({"name": name, "expr": expr, "msg": msg, "target": target}))
PY
)"

if [ -z "$to_register" ]; then
  echo "[cron-reload] no jobs in ${JOBS_FILE} — nothing to do"
  exit 0
fi

added=0
skipped=0
errors=0

while IFS= read -r entry; do
  [ -z "$entry" ] && continue
  name="$(echo "$entry" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["name"])')"
  expr="$(echo "$entry" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["expr"])')"
  msg="$(echo "$entry"  | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["msg"])')"
  target="$(echo "$entry" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["target"])')"

  if echo "$existing_names" | grep -Fxq "$name"; then
    skipped=$((skipped + 1))
    echo "[cron-reload] skip: ${name} (already registered)"
    continue
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[cron-reload] would add: ${name}  (cron='${expr}', session=${target})"
    added=$((added + 1))
    continue
  fi

  if OPENCLAW_GATEWAY_URL="$GATEWAY_URL" openclaw cron add \
       --name "$name" \
       --cron "$expr" \
       --session "$target" \
       --message "$msg" \
       >/dev/null 2>&1; then
    added=$((added + 1))
    echo "[cron-reload] added: ${name}"
  else
    errors=$((errors + 1))
    echo "[cron-reload] ERROR adding ${name}" >&2
  fi
done <<< "$to_register"

echo "[cron-reload] added=${added} skipped=${skipped} errors=${errors}"
[ "$errors" -eq 0 ]
