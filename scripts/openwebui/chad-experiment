# CLI assembly
# ─────────────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="chad-experiment",
        description="Autonomous experiment lifecycle for Chad",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("design", help="Convert proposal → designed record")
    c.add_argument("--hypothesis", required=True, help="What's the bet?")
    c.add_argument("--type", required=True, help="automation|function|tool|knowledge|memory|note|calendar|chad-cron")
    c.add_argument("--success-metric", required=True, help="How will you know it worked?")
    c.add_argument("--baseline", help="Current state (numbers if measurable)")
    c.add_argument("--rollback-path", help="Shell line to undo; auto-generated for chad-webui artifacts")
    c.add_argument("--operator", help="Override CHAD_OPERATOR_SLUG")
    c.add_argument("--evaluation-days", type=int, help="Override eval window")
    c.set_defaults(func=cmd_design)

    c = sub.add_parser("start", help="Materialize artifact via chad-webui, transition to running")
    c.add_argument("--id", required=True)
    c.add_argument("--surface-cmd", required=True, help="e.g. 'automations create' or 'calendar create-event'")
    c.add_argument("--surface-args", required=True, help="JSON object of chad-webui --kebab flags (snake_case keys)")
    c.set_defaults(func=cmd_start)

    c = sub.add_parser("observe", help="Append an observation to a running experiment")
    c.add_argument("--id", required=True)
    c.add_argument("--kind", required=True, help="e.g. 'fired', 'operator_used', 'metric_sample'")
    c.add_argument("--data", help="JSON blob of observation data")
    c.set_defaults(func=cmd_observe)

    c = sub.add_parser("evaluate", help="Apply verdict; auto promote/retire if --score given")
    c.add_argument("--id", required=True)
    c.add_argument("--verdict", choices=["promote", "retire", "extend"], help="Explicit verdict (omit with --score for auto)")
    c.add_argument("--score", type=float, help="0..1 ratio vs baseline; auto-decide via regression_threshold")
    c.add_argument("--notes", help="Free-text reasoning")
    c.add_argument("--extend-days", type=int, help="If verdict=extend, by how long")
    c.set_defaults(func=cmd_evaluate)

    c = sub.add_parser("promote", help="Manual promote (skip evaluate)")
    c.add_argument("--id", required=True)
    c.set_defaults(func=cmd_promote)

    c = sub.add_parser("retire", help="Manual retire (rollback + archive)")
    c.add_argument("--id", required=True)
    c.add_argument("--reason")
    c.set_defaults(func=cmd_retire)

    c = sub.add_parser("list", help="List experiments (active by default)")
    c.add_argument("--operator", help="Filter by operator")
    c.add_argument("--all", action="store_true", help="Include archived")
    c.set_defaults(func=cmd_list)

    c = sub.add_parser("show", help="Show one experiment's full record")
    c.add_argument("--id", required=True)
    c.set_defaults(func=cmd_show)

    c = sub.add_parser("budget", help="Show current budget usage")
    c.set_defaults(func=cmd_budget)

    c = sub.add_parser("ab-start", help="Create paired A/B experiments")
    c.add_argument("--hypothesis", required=True)
    c.add_argument("--type", required=True)
    c.add_argument("--success-metric", required=True)
    c.add_argument("--baseline")
    c.add_argument("--surface-cmd", required=True)
    c.add_argument("--surface-args-a", required=True, help="JSON for variant A")
    c.add_argument("--surface-args-b", required=True, help="JSON for variant B")
    c.add_argument("--operator")
    c.add_argument("--evaluation-days", type=int)
    c.set_defaults(func=cmd_ab_start)

    c = sub.add_parser("ab-pick", help="Pick the winning A/B variant; promote winner, retire loser")
    c.add_argument("--id", required=True, help="Any experiment in the pair (the other is found via ab_pair)")
    c.add_argument("--winner", required=True, choices=["A", "B"])
    c.set_defaults(func=cmd_ab_pick)

    c = sub.add_parser("ab-summary", help="Side-by-side comparison of A/B variants (works across active + archive)")
    c.add_argument("--pair-id", required=True, help="The ab_pair id (from ab-start output or ab_pair field)")
    c.set_defaults(func=cmd_ab_summary)

    c = sub.add_parser("recent-memory", help="Emit recent memory files for hypothesis discovery")
    c.add_argument("--days", type=int, default=7)
    c.add_argument("--sample-chars", type=int, default=3000)
    c.set_defaults(func=cmd_recent_memory)

    c = sub.add_parser("recent-ledger", help="Emit recent ledger events")
    c.add_argument("--limit", type=int, default=40)
    c.set_defaults(func=cmd_recent_ledger)

    return p


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
